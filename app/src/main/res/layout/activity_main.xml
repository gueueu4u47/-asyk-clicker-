<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Asyk Clicker QA"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="Системный фоновый кликер для тестирования"
            android:textColor="#A6A6A6"
            android:textSize="13sp" />

        <EditText android:id="@+id/x" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="X координата" android:inputType="numberDecimal" android:text="540"
            android:textColor="#FFFFFF" android:textColorHint="#666666" />

        <EditText android:id="@+id/y" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Y координата" android:inputType="numberDecimal" android:text="1200"
            android:textColor="#FFFFFF" android:textColorHint="#666666" />

        <EditText android:id="@+id/interval" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Интервал, мс" android:inputType="number" android:text="120"
            android:textColor="#FFFFFF" android:textColorHint="#666666" />

        <EditText android:id="@+id/jitter" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Джиттер, мс" android:inputType="number" android:text="0"
            android:textColor="#FFFFFF" android:textColorHint="#666666" />

        <Button android:id="@+id/openSettings" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="1. Включить сервис в Спецвозможностях" />

        <Button android:id="@+id/start" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="2. Клики по таймеру и свернуть" />

        <Button android:id="@+id/autopilot" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="3. Автопилот со зрением (захват экрана)" />

        <Button android:id="@+id/stop" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Стоп" />

        <TextView android:id="@+id/stats" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:textColor="#7BD3A5" android:textSize="14sp"
            android:fontFamily="monospace" android:text="—" />
    </LinearLayout>
</ScrollView>
